# ============================================================================
# UNIFIED LOCAL=PRODUCTION PROFILE (bot Flask + dashboard Django)
# Copia este archivo a .env.unified y completa valores reales.
# No subas secretos reales al repositorio.
# ============================================================================

# --- Shared identity ---
RESTAURANT_NAME=La Casa del Sabor

# --- Bot Flask ---
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production
HOST=0.0.0.0
PORT=5000
STATE_PERSIST_PATH=data/user_states.json
PARSER_ERROR_LOG_PATH=data/parser_errors.jsonl
MENU_CACHE_TTL_SECONDS=60
ORDERS_CACHE_TTL_SECONDS=30
ADMIN_REMINDER_INTERVAL_SECONDS=300
ADMIN_REMINDER_MAX_SECONDS=3600

# --- Google Sheets (required in production parity) ---
GOOGLE_SPREADSHEET_ID=
# Usa UNA opcion:
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials/google-service-account.json

# --- WhatsApp/Twilio (bot + dashboard fallback notify) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_WHATSAPP_NUMBER=

# --- Dashboard Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SESSION_COOKIE_SECURE=0

# Dashboard DB (local parity: usa el mismo motor que produccion)
DATABASE_URL=postgresql://dashboard:dashboard@localhost:5432/dashboard

# Dashboard <-> Bot
BOT_HEALTH_URL=http://127.0.0.1:5000/health
DASHBOARD_ENABLE_WRITES=1
