# Copiar a .env.dashboard y ajustar valores locales.
# Recomendado: usa .env.unified como base unica y deja aqui solo overrides.

DATABASE_URL=postgresql://dashboard:dashboard@localhost:5432/dashboard
DJANGO_SECRET_KEY=change-me-in-local-dev
DJANGO_DEBUG=0
DEBUG=0
DJANGO_ALLOWED_HOSTS=kiresoft.com,www.kiresoft.com,localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=https://kiresoft.com,https://www.kiresoft.com,http://localhost,http://127.0.0.1
BOT_HEALTH_URL=http://127.0.0.1:5000/health

# Fase 4: acciones de escritura (confirmar pedido, menú). Por defecto solo lectura.
DASHBOARD_ENABLE_WRITES=0

# Produccion: para leer/escribir pedidos reales en Google Sheets.
# Usa UNO de estos dos metodos para credenciales:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SHEETS_CREDENTIALS_PATH=/app/credentials/google-service-account.json
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_CREDENTIALS_PATH=

# Produccion: para enviar WhatsApp al cliente al confirmar pedido desde dashboard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
